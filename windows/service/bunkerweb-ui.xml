<!-- BunkerWeb for Windows: web UI (WinSW 2.12) - port of bunkerweb-ui.service -->
<service>
  <id>bunkerweb-ui</id>
  <name>BunkerWeb (web UI)</name>
  <description>BunkerWeb web UI (listens on 127.0.0.1:7000 by default, see C:\bunkerweb\etc\bunkerweb\ui.env)</description>
  <executable>C:\bunkerweb\usr\share\bunkerweb\python\python.exe</executable>
  <arguments>C:\bunkerweb\usr\share\bunkerweb\windows\bwsvc.py ui</arguments>
  <workingdirectory>C:\bunkerweb</workingdirectory>
  <depend>bunkerweb-nginx</depend>
  <env name="PATH" value="C:\bunkerweb\usr\sbin;C:\bunkerweb\usr\bin;C:\bunkerweb\usr\share\bunkerweb\python;C:\bunkerweb\usr\share\bunkerweb\python\Scripts;%PATH%" />
  <env name="PYTHONPATH" value="C:\bunkerweb\usr\share\bunkerweb\deps\python" />
  <env name="OPENSSL_CONF" value="C:\bunkerweb\usr\ssl\openssl.cnf" />
  <env name="MAGIC" value="C:\bunkerweb\usr\share\misc\magic.mgc" />
  <env name="PYTHONUTF8" value="1" />
  <env name="PYTHONIOENCODING" value="utf-8" />
  <startmode>Automatic</startmode>
  <delayedAutoStart>true</delayedAutoStart>
  <stoptimeout>30 sec</stoptimeout>
  <stopparentprocessfirst>true</stopparentprocessfirst>
  <onfailure action="restart" delay="10 sec" />
  <onfailure action="restart" delay="30 sec" />
  <onfailure action="restart" delay="60 sec" />
  <resetfailure>1 hour</resetfailure>
  <logpath>C:\bunkerweb\var\log\bunkerweb\service</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>5</keepFiles>
  </log>
</service>
